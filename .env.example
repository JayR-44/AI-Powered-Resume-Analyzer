# Groq answer generation.
LLM_PROVIDER=groq
# GROQ_CHAT_MODEL is also accepted if LLM_MODEL is empty.
LLM_MODEL=openai/gpt-oss-120b
# Add your Groq API key to .env, not this example file.
GROQ_API_KEY=
# Completion budget; reasoning also consumes this budget on GPT-OSS.
LLM_MAX_TOKENS=8192
LLM_REASONING_EFFORT=low
